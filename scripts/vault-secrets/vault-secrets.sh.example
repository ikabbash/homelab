# Gets sourced and `secret` gets populated by `vault-secrets-init.sh` script

secret homelab/infra/kv-secret/shared/notifications \
    smtp_host='smtp.example.com' \
    smtp_port='587' \
    smtp_endpoint='smtp.example.com:587' \
    smtp_username='your_smtp_username' \
    smtp_password='your_smtp_password' \
    smtp_domain='example.com' \
    smtp_receiver='hamada@example.com' \
    discord_webhook_url='your_discord_webhook'

secret homelab/infra/kv-secret/shared/gemini \
    gemini_api_key='your_gemini_api_key'

secret homelab/apps/kv-secret/miniflux \
    db_user='miniflux' \
    db_password="$(generate 30)" \
    db_name='miniflux'

secret homelab/apps/kv-secret/n8n \
    db_user='n8n' \
    db_password="$(generate 30)" \
    db_name='n8n'

secret homelab/infra/kv-secret/shared/github-token \
    github_token='your_github_token'